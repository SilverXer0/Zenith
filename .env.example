# Copy this file to .env and fill in the Google OAuth values.
# .env is ignored by Git and must never be committed or shared.

GOOGLE_CLIENT_ID="your-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-oauth-client-secret"

# The Mac launcher derives this from the current Tailscale hostname.
# Leave it commented unless you intentionally need a fixed callback URL.
# GOOGLE_REDIRECT_URI="https://your-mac.ts.net/api/calendar/oauth/callback"

# Zenith's default local model on the Mac.
OLLAMA_MODEL="qwen3:4b"
# OLLAMA_URL="http://127.0.0.1:11434"
